{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neophilism/Development-Deployment-Monitor/blob/main/schemas/deployment-contract.schema.json",
  "title": "Development Deployment Monitor per-repository contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "kind",
    "monitoring",
    "budget",
    "failover",
    "deployments"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^neophilism/[A-Za-z0-9_.-]+$"
    },
    "kind": {
      "enum": [
        "unclassified",
        "web-app",
        "api",
        "worker",
        "static-site",
        "library",
        "research",
        "infrastructure",
        "job",
        "control-plane"
      ]
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "inventory",
            "active"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "minLength": 1
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monthly_usd_max",
        "allow_billable_fallback"
      ],
      "properties": {
        "monthly_usd_max": {
          "type": "number",
          "const": 0
        },
        "allow_billable_fallback": {
          "const": false
        }
      }
    },
    "failover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "stateful",
        "writer_fencing",
        "router"
      ],
      "properties": {
        "mode": {
          "enum": [
            "disabled",
            "observe-only",
            "manual",
            "auto-verified"
          ]
        },
        "stateful": {
          "type": "boolean"
        },
        "writer_fencing": {
          "type": "boolean"
        },
        "router": {
          "enum": [
            "none",
            "verified-external"
          ]
        },
        "stable_origin": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]+)?/?$"
        },
        "runbook": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "^(docs|\\\\.github)/[A-Za-z0-9_./-]+\\\\.md$"
        }
      }
    },
    "deployments": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider",
          "origin",
          "ready_path",
          "expected_status",
          "role",
          "ready_json"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "origin": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]+)?/?$"
          },
          "ready_path": {
            "type": "string",
            "pattern": "^/[^?#]*$",
            "maxLength": 180
          },
          "expected_status": {
            "type": "integer",
            "minimum": 200,
            "maximum": 299
          },
          "role": {
            "enum": [
              "primary",
              "standby"
            ]
          },
          "ready_json": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "minProperties": 1,
            "maxProperties": 20
          },
          "release_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*$"
          },
          "preprovisioned": {
            "type": "boolean"
          },
          "warm": {
            "type": "boolean"
          },
          "quota_verified": {
            "type": "boolean"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "monitoring": {
            "properties": {
              "mode": {
                "const": "active"
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "monitoring"
        ]
      },
      "then": {
        "properties": {
          "deployments": {
            "minItems": 1,
            "contains": {
              "properties": {
                "role": {
                  "const": "primary"
                }
              },
              "required": [
                "role"
              ]
            },
            "minContains": 1,
            "maxContains": 1,
            "items": {
              "allOf": [
                {
                  "required": [
                    "release_sha",
                    "quota_verified"
                  ]
                },
                {
                  "properties": {
                    "quota_verified": {
                      "const": true
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "failover": {
            "properties": {
              "router": {
                "const": "none"
              }
            },
            "required": [
              "router"
            ]
          }
        },
        "required": [
          "failover"
        ]
      },
      "then": {
        "properties": {
          "failover": {
            "not": {
              "required": [
                "stable_origin"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "failover": {
            "properties": {
              "router": {
                "const": "verified-external"
              }
            },
            "required": [
              "router"
            ]
          }
        },
        "required": [
          "failover"
        ]
      },
      "then": {
        "properties": {
          "failover": {
            "required": [
              "stable_origin"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "failover": {
            "properties": {
              "mode": {
                "const": "auto-verified"
              }
            },
            "required": [
              "mode"
            ]
          }
        },
        "required": [
          "failover"
        ]
      },
      "then": {
        "properties": {
          "monitoring": {
            "properties": {
              "mode": {
                "const": "active"
              }
            }
          },
          "failover": {
            "properties": {
              "router": {
                "const": "verified-external"
              }
            }
          },
          "deployments": {
            "contains": {
              "properties": {
                "role": {
                  "const": "standby"
                },
                "preprovisioned": {
                  "const": true
                },
                "warm": {
                  "const": true
                },
                "quota_verified": {
                  "const": true
                }
              },
              "required": [
                "role",
                "preprovisioned",
                "warm",
                "quota_verified"
              ]
            },
            "minContains": 1
          }
        }
      }
    }
  ]
}
